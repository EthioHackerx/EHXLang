{
  "name": "EHXLang",
  "scopeName": "source.ehx",

  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ehx",
          "match": "#.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ehx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ehx",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ehx",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ehx",
          "match": "\\b(set)\\b"
        }
      ]
    },

    "commands": {
      "patterns": [
        {
          "name": "support.function.ehx",
          "match": "\\b(say)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ehx",
          "match": "[+\\-*/=]"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.other.ehx",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}